# Output of `npm run build:engine` (scripts/build-wasm.mjs).
#
# Raw wasm-pack output (.js/.wasm/.d.ts/package.json) stays out of git. The TS glue + base64-inline
# modules that the loaders import MUST be tracked: a clean clone (CI, Vercel, a new contributor) has no
# Rust/wasm-pack, and `ng build @hakistack/ng-daisyui` fails with TS2307 without them.
# The PDF engine is not listed: only the PDFium worker uses it, and that ships as the tracked
# components/pdf-viewer/engine/pdfium/pdfium_worker_inline.ts.
*
!.gitignore
!engine_wasm_glue.ts
!engine_wasm_inline.ts
!document/
document/*
!document/document_wasm_glue.ts
!document/document_wasm_inline.ts
!image/
image/*
!image/image_wasm_glue.ts
!image/image_wasm_inline.ts
