{
  "name": "@hakistack/ng-daisyui",
  "version": "0.3.0",
  "description": "Angular UI components built with DaisyUI and Tailwind CSS",
  "author": "Hakistack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakistack/ng-daisyui.git",
