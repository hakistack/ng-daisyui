{
  "name": "hakistack",
  "version": "0.0.0",
  "description": "Hakistack monorepo: @hakistack/ng-daisyui, @hakistack/i18n and the Rust/WASM engines behind them",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakistack/ng-daisyui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "projects/demo-v4"
  ],
  "scripts": {
    "ng": "ng",
    "clean": "rm -rf dist out-tsc test-results playwright-report blob-report coverage .angular/cache tmp && find . -name .DS_Store -not -path \"./node_modules/*\" -delete",
    "start": "ng serve demo --port 58790",
    "demo": "ng serve demo --open --port 58790",
    "start:v4": "npm --prefix projects/demo-v4 start",
    "demo:v4": "npm --prefix projects/demo-v4 start -- --open",
    "build": "npm run build:ui && npm run build:i18n",
    "build:ui": "node scripts/build-pdfium-worker.mjs && ng build @hakistack/ng-daisyui && node scripts/build-lib-css.mjs && node scripts/fix-exports.mjs && node scripts/build-schematics.mjs",
    "build:watch": "ng build @hakistack/ng-daisyui --watch --configuration development",
    "build:i18n": "ng build @hakistack/i18n && node scripts/build-i18n-cli.mjs && node scripts/build-i18n-schematics.mjs",
    "build:engine": "node scripts/build-wasm.mjs",
    "build:engine:dev": "node scripts/build-wasm.mjs --dev",
    "build:libheif": "bash hakistack-engine/external/libheif-wasm/build.sh",
    "build:libheif:dev": "LIBHEIF_BUILD_PROFILE=dev bash hakistack-engine/external/libheif-wasm/build.sh",
    "build:docs": "ng build demo",
    "vercel:build": "ng build demo --base-href=/ && npm --prefix projects/demo-v4 run build -- --base-href=/v4/ && node scripts/assemble-vercel.mjs",
    "test": "ng test",
    "test:ui": "ng test @hakistack/ng-daisyui && vitest run --config vitest.schematics.config.ts projects/hakistack/ng-daisyui",
    "test:i18n": "ng test @hakistack/i18n && vitest run --config vitest.schematics.config.ts projects/hakistack/i18n",
    "test:engine": "cargo test --manifest-path hakistack-engine/Cargo.toml --workspace",
    "test:schematics": "vitest run --config vitest.schematics.config.ts",
    "test:coverage": "ng test --configuration=coverage",
    "test:docs": "vitest run --config vitest.docs.config.ts",
    "test:consumer": "npm run test:consumer:ui && npm run test:consumer:i18n",
    "test:consumer:ui": "node scripts/consumer-smoke.mjs --package=ui --max-initial-gzip=205",
    "test:consumer:i18n": "node scripts/consumer-smoke.mjs --package=i18n",
    "test:pdf-engine": "node scripts/test-pdf-engine.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint && npm run lint:boundaries",
    "lint:ui": "ng lint @hakistack/ng-daisyui",
    "lint:i18n": "ng lint @hakistack/i18n",
    "lint:engine": "cargo fmt --manifest-path hakistack-engine/Cargo.toml --all --check && cargo clippy --manifest-path hakistack-engine/Cargo.toml --workspace --all-targets -- -D warnings",
    "lint:boundaries": "node scripts/workspace/check-boundaries.mjs",
    "lint:contrast": "node scripts/check-text-contrast.mjs",
    "typecheck": "npm run typecheck:ui && npm run typecheck:i18n",
    "typecheck:ui": "tsc -p projects/hakistack/ng-daisyui/tsconfig.lib.json --noEmit",
    "typecheck:i18n": "tsc -p projects/hakistack/i18n/tsconfig.lib.json --noEmit && tsc -p projects/hakistack/i18n/cli/tsconfig.json --noEmit",
    "check:engine": "cargo check --manifest-path hakistack-engine/Cargo.toml --workspace --all-targets",
    "validate": "node scripts/workspace/validate-package.mjs all",
    "validate:ui": "node scripts/workspace/validate-package.mjs ui",
    "validate:i18n": "node scripts/workspace/validate-package.mjs i18n",
    "size": "size-limit",
    "size:check": "size-limit --json",
    "extract-api-docs": "node scripts/extract-api-docs.mjs",
    "docs:check": "node scripts/extract-api-docs.mjs --check && node scripts/docs/collect-icons.mjs --check && node scripts/check-docs-coverage.mjs",
    "docs:report": "node scripts/check-docs-coverage.mjs --write",
    "docs:snippets": "node scripts/check-doc-snippets.mjs",
    "docs:icons": "node scripts/docs/collect-icons.mjs",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "clean:engine": "cargo clean --manifest-path hakistack-engine/Cargo.toml && rm -rf hakistack-engine/pkg hakistack-engine/pkg-document hakistack-engine/pkg-image hakistack-engine/pkg-pdf",
    "clean:libheif": "rm -rf hakistack-engine/external/libheif-wasm/build hakistack-engine/external/libheif-wasm/vendor projects/hakistack/ng-daisyui/src/lib/wasm/libheif",
    "release": "node scripts/release.mjs",
    "publish:ui": "node scripts/workspace/publish.mjs ui",
    "publish:i18n": "node scripts/workspace/publish.mjs i18n",
    "link:ui": "cd dist/hakistack/ng-daisyui && npm link",
    "link:i18n": "cd dist/hakistack/i18n && npm link",
    "prepare": "husky",
    "test:consumer:variants": "node scripts/consumer-smoke.mjs --package=ui --variant=datagrid --max-initial-gzip=195 && node scripts/consumer-smoke.mjs --package=ui --variant=forms --max-initial-gzip=270 && node scripts/consumer-smoke.mjs --package=ui --variant=pdf --max-initial-gzip=240"
  },
  "size-limit": [
    {
      "name": "Whole-library FESM, gzip (growth guard — NOT what consumers ship; see scripts/consumer-smoke.mjs)",
      "path": "dist/hakistack/ng-daisyui/fesm2022/hakistack-ng-daisyui.mjs",
      "gzip": true,
      "limit": "700 kB"
    }
  ],
  "prettier": {
    "printWidth": 140,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.6.3",
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/aria": "^21.2.9",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@jsverse/transloco": "^8.2.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@lucide/angular": "^1.7.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tiptap/suggestion": "^3.22.4",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.8",
    "foliate-js": "^1.0.1",
    "fuse.js": "^7.2.0",
    "heic2any": "^0.0.4",
    "libphonenumber-js": "^1.12.42",
    "motion": "^12.38.0",
    "postal-mime": "^2.7.4",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.10",
    "@anthropic-ai/sdk": "^0.133.0",
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-file-handler": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-istanbul": "^4.1.2",
    "angular-eslint": "^21.3.1",
    "buffer": "^6.0.3",
    "daisyui": "^5.5.19",
    "esbuild": "0.27.3",
    "eslint": "^10.2.0",
    "events": "^3.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "ng-packagr": "^21.2.2",
    "prettier": "^3.8.1",
    "shiki": "^4.0.2",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.2.2",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8"
  }
}
